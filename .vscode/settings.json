{
  "tailwindCSS.classAttributes": ["class", ".*-class(es)?", "theme", "ui"],
  "tailwindCSS.experimental.classRegex": [
    ["Theme \\=([^;]*);?", "'([^']*)'"],
    ["Theme \\=([^;]*);?", "\"([^\"]*)\""],
    ["Theme \\=([^;]*);?", "\\`([^\\`]*)\\`"],
    ["Class \\=([^;]*);?", "'([^']*)'"],
    ["Classes \\=([^;]*);?", "'([^']*)'"],
    ["Class \\=([^;]*);?", "\"([^\"]*)\""],
    ["Classes \\=([^;]*);?", "\"([^\"]*)\""],
    ["Class \\=([^;]*);?", "\\`([^\\`]*)\\`"],
    ["Classes \\=([^;]*);?", "\\`([^\\`]*)\\`"],
    ["tw`(.*?)`", "tw\\('(.*?)'\\)", "tw\\(\\s*('(.*?)'|\"(.*?)\")\\s*\\)"],
    ["ui:\\s*{([^)]*)\\s*}", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ]
}

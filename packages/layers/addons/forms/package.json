{
  "name": "@plutocms/forms",
  "type": "module",
  "version": "0.1.0",
  "description": "An add-on layer for Pluto: forms for any site, built from blocks in the admin or written in code, with spam protection, a store for the submissions and an email for each one",
  "author": "Victor Ribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/pluto/tree/main/packages/layers/addons/forms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/pluto.git",
    "directory": "packages/layers/addons/forms"
  },
  "bugs": {
    "url": "https://github.com/plutocms/pluto/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "pluto",
    "forms",
    "contact-form",
    "turnstile"
  ],
  "main": "./nuxt.config.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "nuxt prepare ../../../../playground && vue-tsc --noEmit -p ../../../../playground/.nuxt/tsconfig.app.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@plutocms/core": ">=0.75.1 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@plutocms/core": {
      "optional": true
    }
  }
}

{
  "name": "@plutocms/seo",
  "type": "module",
  "version": "0.3.0",
  "description": "An add-on layer for Pluto: SEO fields, head tags, a sitemap, robots.txt and an RSS feed, for every backend",
  "author": "Victor Ribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/pluto/tree/main/packages/layers/addons/seo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/pluto.git",
    "directory": "packages/layers/addons/seo"
  },
  "bugs": {
    "url": "https://github.com/plutocms/pluto/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "pluto",
    "seo",
    "sitemap",
    "robots",
    "rss"
  ],
  "main": "./nuxt.config.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "nuxt prepare ../../../../playground && vue-tsc --noEmit -p ../../../../playground/.nuxt/tsconfig.app.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@plutocms/core": ">=0.57.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@plutocms/core": {
      "optional": true
    }
  }
}

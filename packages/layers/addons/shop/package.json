{
  "name": "@plutocms/shop",
  "type": "module",
  "version": "0.1.0",
  "description": "An add-on layer for Pluto shops: a cart saved in the browser, and the price helpers, for every backend",
  "author": "Victor Ribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/pluto/tree/main/packages/layers/addons/shop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/pluto.git",
    "directory": "packages/layers/addons/shop"
  },
  "bugs": {
    "url": "https://github.com/plutocms/pluto/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "pluto",
    "shop",
    "cart"
  ],
  "main": "./nuxt.config.ts",

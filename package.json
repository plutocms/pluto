    "@iconify-json/simple-icons": "^1.2.100",
    "@internationalized/date": "^3.12.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.12.0",
    "@plutocms/utils": "^0.2.1",
    "@tanstack/charts": "^1.1.0",
    "@vueuse/nuxt": "^14.4.0",
    "marked": "^17.0.3",

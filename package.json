{
  "name": "pluto-monorepo",
  "type": "module",
  "private": true,
  "description": "The Pluto core and its add-on layers",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/layers/addons/*",
    "playground"
  ],
  "scripts": {
    "postinstall": "bun run --cwd packages/core dev:prepare",
    "dev": "bun run --cwd playground dev",
    "build": "bun run --cwd packages/core build",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/layers/addons/3d typecheck",
    "test": "bun run --cwd packages/core test && bun run --cwd packages/layers/addons/3d test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "eslint-flat-config-utils": "^3.2.0"
  }
}
